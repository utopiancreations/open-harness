# ===========================================================================
# OPEN HARNESS // AUTONOMOUS BACKEND & CLOUD ENVIRONMENT TEMPLATE
# Populate required API keys & credentials for your deployment
# ===========================================================================

# Application environment mode (development, staging, production)
APP_ENV=development

# WebRTC STUN server URL for P2P NAT traversal
STUN_SERVER_URL=stun:stun.l.google.com:19302

# WebRTC TURN relay server URL (optional for strict NATs)
TURN_SERVER_URL=turn:turn.example.com:3478

# TURN relay server authentication token
TURN_SERVER_CREDENTIAL=your_turn_credential_here
